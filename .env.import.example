# Importer settings (docs: "Polish Tiger — pobieranie danych i dedykowana baza", section 10).
# Copy to .env.import (ignored by git), fill in, then: node --env-file=.env.import --import tsx scripts/import.ts <command>
# Every value is required; the importer refuses to start with any of them missing.

# Dedicated importer credentials (not the app's). Migrations use MIGRATION_DATABASE_URL.
IMPORT_DATABASE_URL=
MIGRATION_DATABASE_URL=
SOURCE_BASE_URL=https://www.americandragon.com
# Pilot: exactly 20 herbs + 10 formulas = 30 card pages. Discovery reads 5 index pages.
IMPORT_MAX_PAGES=30
IMPORT_CONCURRENCY=1
IMPORT_DELAY_SECONDS=2
IMPORT_MAX_RETRIES=3
IMPORT_ALLOW_FULL_IMPORT=false
# Stays false until the owner has decided on rights to copy/store the source (docs/source-audit.md).
IMPORT_SOURCE_RIGHTS_CONFIRMED=false
# raw_html keeps fetched HTML so the parser can re-run without downloads; excerpts_only keeps hashes and cited fragments.
IMPORT_RETENTION=excerpts_only
IMPORT_USER_AGENT=PolishTigerImporter/1.0 (private educational atlas; contact: owner)
AI_TRANSLATION_ENABLED=false
AI_MAX_RECORDS_PER_RUN=0
AI_MAX_SPEND_EUR=0
# Optional: also write each run report as Markdown here.
IMPORT_REPORT_DIR=
