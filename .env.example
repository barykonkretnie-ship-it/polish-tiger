# Server-only values. Never add NEXT_PUBLIC_ to these variables.
# Copy Supabase Connect -> Transaction pooler URI and supply its database password.
POLISH_TIGER_DATABASE_URL=
# Use a unique strong password, minimum 16 characters on Vercel.
POLISH_TIGER_ADMIN_PASSWORD=
# Independent random signing secret, minimum 32 characters on Vercel.
POLISH_TIGER_SESSION_SECRET=
# Vercel always protects read access; enable the same mode locally if desired.
POLISH_TIGER_PRIVATE_ACCESS=true
